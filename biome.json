{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "files": {
    "includes": [
      "scripts/app.mjs",
      "scripts/switcher.js",
      "src/**/*.js",
      "netlify/**/*.js",
      "tests/**/*.mjs",
      "e2e/**/*.mjs",
      "playwright.config.mjs",
      "*.json"
    ]
  }
}
