{
  "$schema": "https://biomejs.dev/schemas/2.4.11/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "files": {
    "includes": [
      "scripts/app.js",
      "scripts/switcher.js",
      "src/**/*.js",
      "netlify/**/*.js",
      "tests/**/*.mjs",
      "*.json"
    ]
  }
}
