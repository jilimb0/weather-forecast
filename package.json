{
  "name": "weather-forecast",
  "version": "2.0.0",
  "description": "Production-ready weather app with Netlify Functions, PWA support, and modern UI.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "lint": "biome check --diagnostic-level=error .",
    "format": "biome check --write .",
