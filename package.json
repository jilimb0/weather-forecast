    "node": ">=26.0.0"
  },
  "bugs": {
    "url": "https://github.com/jilimb0/weather-forecast/issues"
  },
  "homepage": "https://github.com/jilimb0/weather-forecast#readme",
  "dependencies": {
    "@sentry/node": "^10.62.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@playwright/test": "^1.59.1",
    "chokidar": "^5.0.0",
    "jsdom": "^29.0.2",
    "vitest": "^4.1.4"
  }
